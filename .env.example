# Copy to `.env.local` for development (`bun run dev`), or add these to your
# hosting provider's environment settings for production.
# `.env*` is gitignored — this example file is the tracked exception.

# --- Discord presence widget (home page "Live" row) -----------------------
# Enables the Discord widget via the Lanyard API (https://lanyard.rest).
# Unset → the widget is hidden entirely, no broken state is rendered.
# Find your ID: Discord → Settings → Advanced → Developer Mode → right-click
# yourself → Copy User ID.
NEXT_PUBLIC_DISCORD_ID=

# --- Contact form (Resend) ------------------------------------------------
# Server-only API key from https://resend.com/api-keys.
# Unset → POST /api/contact answers 503 and the form shows a friendly
# "sending isn't set up yet" note pointing at your direct email.
RESEND_API_KEY=

# Verified sender. Must be a domain (or address) verified in Resend.
# While testing you can use Resend's sandbox: onboarding@resend.dev
CONTACT_FROM="Ayush <contact@synax.me>"

# Inbox that receives submissions. Defaults to user-synax@proton.me if unset.
CONTACT_TO=user-synax@proton.me
